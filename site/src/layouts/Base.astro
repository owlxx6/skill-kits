---
import "../styles/global.css";
import Icon from "../components/Icon.astro";
import { loadCatalog } from "../lib/catalog";

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const pageTitle = title === "Skill Kits" ? title : `${title} - Skill Kits`;
const updated = loadCatalog().generatedAt.slice(0, 10);
const path = Astro.url.pathname;
const nav = [
  { href: "/#kits", label: "Kits", current: path.startsWith("/kits/") ? "true" : undefined },
  { href: "/search/", label: "Search", current: path.startsWith("/search/") ? "page" : undefined },
  { href: "/methodology/", label: "How we pick", current: path.startsWith("/methodology/") ? "page" : undefined },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <script is:inline>
      try {
        const theme = localStorage.getItem("skill-kits-theme");
        if (theme === "night") document.documentElement.dataset.theme = "night";
      } catch { /* Storage can be unavailable in private contexts. */ }
      // Motion is opt-in: entrance animations only hide content once this class is set,
      // so the page stays complete without JavaScript or with reduced motion.
      if ("IntersectionObserver" in window && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        document.documentElement.classList.add("motion");
      }
    </script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container">
        <a class="brand" href="/">
          <span class="brand-mark"><Icon name="layers" size={18} /></span>
          Skill Kits
        </a>
        <nav class="site-nav" aria-label="Main">
          {nav.map((item) => <a href={item.href} aria-current={item.current}>{item.label}</a>)}
        </nav>
        <button class="theme-toggle" type="button" data-theme-toggle aria-label="Night Shift" title="Night Shift" aria-pressed="false" hidden>
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
            <circle cx="12" cy="12" r="8.5" /><path d="M12 3.5a8.5 8.5 0 0 1 0 17Z" fill="currentColor" stroke="none" />
          </svg>
        </button>
      </div>
    </header>
    <main id="main" tabindex="-1">
      <div class="container page-body"><slot /></div>
    </main>
    <footer class="site-footer">
      <div class="container">
        <p>Catalog updated <time datetime={updated}>{updated}</time></p>
        <nav class="footer-links" aria-label="Footer">
          <a href="/methodology/">How we pick</a>
          <a href="https://github.com/owlxx6/skill-kits">
            Source on GitHub <Icon name="external-link" size={14} />
          </a>
        </nav>
      </div>
    </footer>
  </body>
</html>

<script>
  const themeToggle = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
  if (themeToggle) {
    const syncTheme = () => {
      themeToggle.setAttribute("aria-pressed", String(document.documentElement.dataset.theme === "night"));
      const meta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
      if (meta) meta.content = document.documentElement.dataset.theme === "night" ? "#141414" : "#ffffff";
    };
    syncTheme();
    themeToggle.hidden = false;
    themeToggle.addEventListener("click", () => {
      const theme = document.documentElement.dataset.theme === "night" ? "day" : "night";
      document.documentElement.dataset.theme = theme;
      try { localStorage.setItem("skill-kits-theme", theme); } catch { /* The toggle still works without persistence. */ }
      syncTheme();
    });
    window.addEventListener("storage", (event) => {
      if (event.key === "skill-kits-theme" || event.key === null) {
        document.documentElement.dataset.theme = event.newValue === "night" ? "night" : "day";
        syncTheme();
      }
    });
  }
  // "/" focuses the page's search box, as on most developer sites; ignored while typing.
  document.addEventListener("keydown", (event) => {
    if (event.key !== "/" || event.metaKey || event.ctrlKey || event.altKey) return;
    const target = event.target;
    if (target instanceof HTMLElement && (target.isContentEditable || target.closest("input, textarea, select"))) return;
    const input = document.querySelector<HTMLInputElement>("input[data-search-shortcut]");
    if (!input) return;
    event.preventDefault();
    input.focus();
    input.select();
  });

  // One observer for every entrance on the page: [data-reveal] and [data-fill] get "is-visible" (staggered
  // within each batch) and [data-count-to] counts up from zero. Each runs once.
  const root = document.documentElement;
  if (root.classList.contains("motion")) {
    const COUNT_MS = 1000;
    const easeOut = (t: number) => 1 - (1 - t) ** 3;
    const countUp = (element: HTMLElement, target: number) => {
      const start = performance.now();
      const step = (now: number) => {
        const progress = Math.min(1, (now - start) / COUNT_MS);
        element.textContent = String(Math.round(target * easeOut(progress)));
        if (progress < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    };

    const observer = new IntersectionObserver(
      (entries) => {
        let order = 0;
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const element = entry.target as HTMLElement;
          observer.unobserve(element);
          const target = Number(element.dataset.countTo);
          if (element.dataset.countTo !== undefined && Number.isFinite(target)) {
            countUp(element, target);
            continue;
          }
          element.style.setProperty("--reveal-delay", `${Math.min(order, 6) * 70}ms`);
          element.classList.add("is-visible");
          order += 1;
        }
      },
      { threshold: 0.15, rootMargin: "0px 0px -40px 0px" },
    );

    for (const element of document.querySelectorAll<HTMLElement>("[data-reveal], [data-fill], [data-count-to]")) {
      if (element.dataset.countTo !== undefined) element.textContent = "0";
      observer.observe(element);
    }
  }
</script>

<style>
  main:focus { outline: none; }
</style>
