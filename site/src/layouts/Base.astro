---
import "../styles/global.css";
import CommandPalette from "../components/CommandPalette.astro";
import Icon from "../components/Icon.astro";
import SideNav from "../components/SideNav.astro";
import { loadCatalog } from "../lib/catalog";

interface Props {
  title: string;
  description: string;
  // The home page lets its hero sit under a transparent top bar; every other page gets a solid one.
  landing?: boolean;
  // Share image, as a path under the site root. Kit pages pass their own; every other page uses the default one.
  image?: string;
}
const { title, description, landing = false, image = "/og/default.png" } = Astro.props;
const pageTitle = title === "Skill Kits" ? title : `${title} - Skill Kits`;
const catalog = loadCatalog();
const updated = catalog.generatedAt.slice(0, 10);
const path = Astro.url.pathname;
// Absolute links for sharing exist only when the public address is known (SITE_URL at build time, see astro.config.mjs).
const canonical = Astro.site ? new URL(path, Astro.site).href : undefined;
const shareImage = Astro.site ? new URL(image, Astro.site).href : undefined;
// The home page and the Browse page already have a large search box, so the top bar does not repeat it there.
const showTopSearch = !landing && !path.startsWith("/search/");
const current = (match: boolean) => (match ? "page" : undefined);
---
<!doctype html>
<html lang="en" data-theme="day">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141414" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      // Before first paint: the visitor's saved choice, else their system setting.
      (function () {
        var saved = null;
        try { saved = localStorage.getItem("skill-kits-theme"); } catch (e) { /* storage can be unavailable */ }
        var system = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches ? "night" : "day";
        document.documentElement.dataset.theme = saved === "night" || saved === "day" ? saved : system;
      })();
    </script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:site_name" content="Skill Kits" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && <meta property="og:url" content={canonical} />}
    {shareImage && <meta property="og:image" content={shareImage} />}
    {shareImage && <meta property="og:image:width" content="1200" />}
    {shareImage && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content={shareImage ? "summary_large_image" : "summary"} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="shell" data-landing={landing ? "" : undefined}>
      <div class="main-col">
        <header class="topbar">
          <div class="topbar-inner">
            <details class="menu" data-menu>
              <summary class="icon-button" aria-label="Menu">
                <Icon name="menu" size={20} class="icon-open" />
                <Icon name="x" size={20} class="icon-close" />
              </summary>
              <div class="menu-panel">
                <SideNav path={path} label="Main menu" />
              </div>
            </details>
            <a class="brand" href="/"><span class="brand-mark" aria-hidden="true"></span>Skill Kits</a>
            <nav class="topnav" aria-label="Primary">
              <details class="nav-menu" data-nav-menu data-active={path.startsWith("/kits/") ? "" : undefined}>
                <summary>Kits <Icon name="chevron-down" size={14} /></summary>
                <div class="nav-panel nav-panel-kits">
                  <ul>
                    {catalog.kits.map((kit) => (
                      <li><a href={`/kits/${kit.id}/`} aria-current={current(path === `/kits/${kit.id}/`)}>{kit.title}</a></li>
                    ))}
                  </ul>
                  <a class="nav-all" href="/#kits">All kits <Icon name="chevron-right" size={14} /></a>
                </div>
              </details>
              <details class="nav-menu" data-nav-menu data-active={path.startsWith("/collections/") || path.startsWith("/skills/") ? "" : undefined}>
                <summary>Browse <Icon name="chevron-down" size={14} /></summary>
                <div class="nav-panel">
                  <ul>
                    <li><a href="/search/?type=collection">Collections</a></li>
                    <li><a href="/search/?type=skill">Skills</a></li>
                    <li><a href="/search/">Search everything</a></li>
                  </ul>
                </div>
              </details>
              <a href="/methodology/" aria-current={current(path.startsWith("/methodology/"))}>How we pick</a>
            </nav>
            <div class="topbar-actions">
              {showTopSearch && (
                <a class="top-search" href="/search/" data-palette-open aria-label="Search skills and collections" aria-keyshortcuts="/ Control+K Meta+K">
                  <Icon name="search" size={18} />
                  <span>Search skills</span>
                  <kbd aria-hidden="true">/</kbd>
                </a>
              )}
              {showTopSearch && <a class="icon-button search-link" href="/search/" data-palette-open aria-label="Search"><Icon name="search" size={20} /></a>}
              <button class="icon-button theme-toggle" type="button" data-theme-toggle aria-label="Night mode" title="Night mode" aria-pressed="false">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <circle cx="12" cy="12" r="8.5" /><path d="M12 3.5a8.5 8.5 0 0 1 0 17Z" fill="currentColor" stroke="none" />
                </svg>
              </button>
            </div>
          </div>
        </header>

        <main id="main" tabindex="-1">
          <slot />
        </main>

        <footer class="site-footer">
          <div class="wrap">
            <p>Catalog updated <time datetime={updated}>{updated}</time>. Static site: no accounts, no tracking.</p>
            <nav aria-label="Footer">
              <a href="/methodology/">How we pick</a>
            </nav>
          </div>
        </footer>
      </div>
    </div>
    <CommandPalette />
  </body>
</html>

<script>
  const KEY = "skill-kits-theme";
  const root = document.documentElement;
  const toggle = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
  const system = window.matchMedia("(prefers-color-scheme: dark)");
  const saved = (): string | null => {
    try { return localStorage.getItem(KEY); } catch { return null; }
  };
  const sync = () => {
    const night = root.dataset.theme === "night";
    toggle?.setAttribute("aria-pressed", String(night));
    toggle?.setAttribute("title", night ? "Switch to day mode" : "Switch to night mode");
  };
  sync();
  toggle?.addEventListener("click", () => {
    const theme = root.dataset.theme === "night" ? "day" : "night";
    root.dataset.theme = theme;
    try { localStorage.setItem(KEY, theme); } catch { /* The toggle still works without persistence. */ }
    sync();
  });
  // Follow the system setting until the visitor makes a choice of their own.
  system.addEventListener("change", (event) => {
    const choice = saved();
    if (choice === "night" || choice === "day") return;
    root.dataset.theme = event.matches ? "night" : "day";
    sync();
  });
  window.addEventListener("storage", (event) => {
    if (event.key !== KEY && event.key !== null) return;
    root.dataset.theme = event.newValue === "night" ? "night" : event.newValue === "day" ? "day" : system.matches ? "night" : "day";
    sync();
  });

  // Phone menu: Escape closes it and returns focus to its button.
  const menu = document.querySelector<HTMLDetailsElement>("[data-menu]");
  menu?.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && menu.open) {
      menu.open = false;
      menu.querySelector("summary")?.focus();
    }
  });

  // Desktop dropdowns: one open at a time; a click elsewhere, Escape, or tabbing out closes them.
  const navMenus = [...document.querySelectorAll<HTMLDetailsElement>("[data-nav-menu]")];
  for (const item of navMenus) {
    item.addEventListener("toggle", () => {
      if (!item.open) return;
      for (const other of navMenus) if (other !== item) other.open = false;
    });
    item.addEventListener("focusout", (event) => {
      const next = event.relatedTarget;
      if (item.open && next instanceof Node && !item.contains(next)) item.open = false;
    });
  }
  document.addEventListener("click", (event) => {
    for (const item of navMenus) if (item.open && event.target instanceof Node && !item.contains(event.target)) item.open = false;
  });
  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    for (const item of navMenus) {
      if (!item.open) continue;
      item.open = false;
      item.querySelector("summary")?.focus();
    }
  });

  // "/" focuses the page's own search box when it has one (the Browse page); everywhere else it opens the search palette.
  // Ignored while typing. Ctrl+K opens the palette on every page (see CommandPalette.astro).
  document.addEventListener("keydown", (event) => {
    if (event.key !== "/" || event.metaKey || event.ctrlKey || event.altKey) return;
    const target = event.target;
    if (target instanceof HTMLElement && (target.isContentEditable || target.closest("input, textarea, select"))) return;
    const own = [...document.querySelectorAll<HTMLInputElement>("input[data-search-primary]")].find((input) => input.offsetParent !== null);
    event.preventDefault();
    if (own) {
      own.focus();
      own.select();
    } else {
      document.dispatchEvent(new CustomEvent("palette:open"));
    }
  });
</script>
