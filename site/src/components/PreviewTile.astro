---
// A drawn preview for a home tile (a repository or a skill). Decorative: the link around it carries the accessible name.
import type { Catalog, CatalogCollection, CatalogSkill } from "../lib/catalog";

type Props =
  | { kind: "collection"; tone: number; catalog: Catalog; collection: CatalogCollection }
  | { kind: "skill"; tone: number; skill: CatalogSkill };
const props = Astro.props;
const tone = String(props.tone % 5); // dark, white, Verde Abetone, grey, terracotta
const skillNames = props.kind === "collection"
  ? props.collection.catalogSkillIds.flatMap((id) => props.catalog.skills.find((entry) => entry.id === id)?.name ?? []).slice(0, 4)
  : [];
---
<div class="tile" data-tone={tone} aria-hidden="true">
  {props.kind === "collection" && (
    <>
      <div class="tile-cmd"><span>$ </span>npx skills add {props.collection.id}</div>
      <ul class="tile-list">{skillNames.map((name, i) => <li><span class="n">{String(i + 1).padStart(2, "0")}</span><span>{name}</span></li>)}</ul>
    </>
  )}
  {props.kind === "skill" && (
    <>
      <p class="tile-title">{props.skill.name}</p>
      <p class="tile-text">{props.skill.review.why}</p>
    </>
  )}
</div>
