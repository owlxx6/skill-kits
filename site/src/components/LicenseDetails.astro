---
import Icon from "./Icon.astro";
import type { CatalogSkill } from "../lib/catalog";
interface Props { skill: CatalogSkill; }
const { skill } = Astro.props;
const categories: Record<string, string> = { permissive: "Permissive", copyleft: "Copyleft", other: "Other license", none: "No license found", unclear: "Unclear license" };
const category = skill.licenseCategory ? categories[skill.licenseCategory] : undefined;
---
<span class="license-details">
  <span>{skill.license}</span>
  {category && <span class="category">{category}</span>}
  {skill.licenseEvidence?.url && <a href={skill.licenseEvidence.url}>License source <Icon name="external-link" size={12} /></a>}
</span>
