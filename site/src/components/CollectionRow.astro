---
// One numbered part of a kit: a whole repository, its scope, its command and its checks.
import CopyCommand from "./CopyCommand.astro";
import ScopeNote from "./ScopeNote.astro";
import TrustLine from "./TrustLine.astro";
import { type Catalog, type CatalogCollection, collectionHref, collectionInstallCommand, collectionLicenseLabel, listedSecurityLevel } from "../lib/catalog";

interface Props {
  catalog: Catalog;
  collection: CatalogCollection;
  index: number;
}
const { catalog, collection, index } = Astro.props;
---
<li class="part" data-license={collection.license}>
  <span class="part-no" aria-hidden="true">{index + 1}</span>
  <div class="part-body">
    <h3><span class="visually-hidden">Part {index + 1}: </span><a href={collectionHref(collection.id)}>{collection.id}</a></h3>
    <ScopeNote collection={collection} />
    <CopyCommand command={collectionInstallCommand(collection.id)} label={`Copy install command for ${collection.id}`} />
    <TrustLine
      license={collectionLicenseLabel(collection)}
      level={listedSecurityLevel(catalog, collection.id)}
      shortLevel={false}
      reviewed
      updated={collection.pushedAt}
      source={collection.url}
    />
  </div>
</li>
