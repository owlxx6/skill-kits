---
import Icon from "./Icon.astro";

interface Props {
  inputId: string;
  formId?: string;
  // The Browse page filters as you type, so it needs no submit button.
  submitButton?: boolean;
  placeholder?: string;
  value?: string;
}
const { inputId, formId, submitButton = true, placeholder = "Search by task, file type or publisher", value } = Astro.props;
---
<form class="search-form" id={formId} action="/search/" method="get" role="search">
  <label for={inputId} class="visually-hidden">Search skills and collections</label>
  <div class="search-input">
    <Icon name="search" size={20} />
    <input
      id={inputId}
      type="search"
      name="q"
      value={value}
      placeholder={placeholder}
      autocomplete="off"
      spellcheck="false"
      enterkeyhint="search"
      aria-keyshortcuts="/"
      data-search-shortcut
      data-search-primary
    />
  </div>
  {submitButton && <button class="button primary" type="submit">Search</button>}
</form>
