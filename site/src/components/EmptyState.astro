---
import Icon from "./Icon.astro";
import type { IconName } from "../lib/icons";

interface Props {
  icon: IconName;
  title: string;
  headingLevel?: 2 | 3;
}
const { icon, title, headingLevel = 2 } = Astro.props;
const Heading = headingLevel === 2 ? "h2" : "h3";
---
<div class="empty-state">
  <span class="icon-tile large quiet"><Icon name={icon} size={26} /></span>
  <Heading>{title}</Heading>
  <slot />
</div>
