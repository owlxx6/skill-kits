---
import CopyCommand from "./CopyCommand.astro";
import TrustLine from "./TrustLine.astro";
import { type CatalogSkill, collectionHref, securityLevel, skillHref, skillInstallCommand } from "../lib/catalog";

interface Props {
  skill: CatalogSkill;
  // Hidden on a collection page, where every skill comes from the same repository.
  showRepo?: boolean;
  headingLevel?: 2 | 3;
}
const { skill, showRepo = true, headingLevel = 3 } = Astro.props;
const Heading = headingLevel === 2 ? "h2" : "h3";
const level = securityLevel(skill);
---
<li
  class="row"
  data-license={skill.license}
  data-security={level}
  data-review={skill.reviewScore}
  data-updated={skill.pushedAt}
  data-name={skill.name}
>
  <div class="row-main">
    <div class="row-title">
      <Heading><a href={skillHref(skill.id)}>{skill.name}</a></Heading>
      {showRepo && <a class="row-repo" href={collectionHref(skill.repo)}>{skill.repo}</a>}
    </div>
    <p class="row-why">{skill.review.why}</p>
    <TrustLine license={skill.license} level={level} updated={skill.pushedAt} />
  </div>
  <div class="row-action">
    <CopyCommand command={skillInstallCommand(skill)} label={`Copy install command for ${skill.name}`} />
  </div>
</li>
