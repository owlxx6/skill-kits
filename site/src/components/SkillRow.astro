---
import CopyCommand from "./CopyCommand.astro";
import TrustLine from "./TrustLine.astro";
import { hasInstallIdentifier } from "../lib/installation";
import { type CatalogSkill, collectionHref, securityLevel, skillHref, skillInstallCommand } from "../lib/catalog";

interface Props {
  skill: CatalogSkill;
  // Hidden on a collection page, where every skill comes from the same repository.
  showRepo?: boolean;
  headingLevel?: 2 | 3;
}
const { skill, showRepo = true, headingLevel = 3 } = Astro.props;
const Heading = headingLevel === 2 ? "h2" : "h3";
const level = securityLevel(skill);
---
<li
  class="row"
  data-license={skill.license}
  data-security={level}
  data-review={skill.reviewScore}
  data-updated={skill.pushedAt}
  data-name={skill.name}
  data-editorial={skill.review ? "reviewed" : "source"}
>
  <div class="row-main">
    <div class="row-title">
      <Heading><a href={skillHref(skill.id)}>{skill.name}</a></Heading>
      {showRepo && <a class="row-repo" href={collectionHref(skill.repo)}>{skill.repo}</a>}
    </div>
    <p class="row-why">{skill.review?.why ?? skill.description}</p>
    {!skill.review && <p class="small muted">Source listing · not editorially reviewed</p>}
    {skill.installable === false && <p class="small muted">{skill.path} · See the source for installation details.</p>}
    <TrustLine license={skill.license} level={skill.review ? level : undefined} updated={skill.pushedAt} />
  </div>
  <div class="row-action">
    {hasInstallIdentifier(skill) ? <CopyCommand command={skillInstallCommand(skill)} label={`Copy install command for ${skill.name}`} /> : <a class="button" href={skill.url}>View source</a>}
  </div>
</li>
