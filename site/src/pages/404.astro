---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import SearchBox from "../components/SearchBox.astro";
---
<Base title="Page not found" description="This page does not exist.">
  <div class="wrap page">
    <section class="page-head" aria-labelledby="nf-title">
      <p class="eyebrow mono">404</p>
      <h1 id="nf-title" class="display">This page does not exist.</h1>
      <p class="lead">The skill or kit may have been removed after a review. Search the catalog, or start again from the kits.</p>
      <div style="max-width: 560px; width: 100%"><SearchBox inputId="not-found-search" /></div>
      <div class="button-row">
        <a class="button primary" href="/#kits">See all kits <Icon name="arrow-right" size={16} /></a>
        <a class="button" href="/methodology/">How we pick</a>
      </div>
    </section>
  </div>
</Base>
