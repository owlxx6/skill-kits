---
import Base from "../layouts/Base.astro";
import PreviewTile from "../components/PreviewTile.astro";
import Rail from "../components/Rail.astro";
import SecurityLevel from "../components/SecurityLevel.astro";
import { collectionHref, collectionsByStars, formatCount, loadCatalog, plural, securityLevel, skillHref, topSkillPerRepo } from "../lib/catalog";

const catalog = loadCatalog();
const top = collectionsByStars(catalog, 3);
const best = topSkillPerRepo(catalog, 6);
---
<Base title="Skill Kits" description="Reviewed agent skills grouped into kits by job: what to install, in which order, with one command each.">
  <div class="wrap page">
    <section class="hero" aria-labelledby="hero-title">
      <h1 id="hero-title" class="display">Pick a job.<br /><span class="accent">Install the whole kit.</span></h1>
      <p class="lead">Reviewed skills for AI coding agents, grouped by the work you want done.</p>
      <div class="hero-actions">
        <a class="button primary" href="#kits">Browse kits</a>
        <a class="button" href="/search/">Search skills</a>
      </div>
      <ol class="how" aria-label="How it works">
        <li><span class="step-no">1</span>Pick a kit</li>
        <li><span class="step-no">2</span>Copy the command</li>
        <li><span class="step-no">3</span>Check license and scan</li>
      </ol>
    </section>

    <Rail id="kits" title="Kits">
      {catalog.kits.map((kit, index) => (
        <li>
          <a class="tile-link" href={`/kits/${kit.id}/`}>
            <span class="visually-hidden">{kit.title}: {plural(kit.collections.length, "collection")}{kit.skills.length > 0 ? `, ${plural(kit.skills.length, "single skill")}` : ""}</span>
            <PreviewTile kind="kit" tone={index} kit={kit} />
          </a>
        </li>
      ))}
    </Rail>

    <Rail id="top-collections" title="Most starred collections" viewAll={{ href: "/search/?type=collection", label: "All collections" }}>
      {top.map((collection, index) => (
        <li class="ranked">
          <span class="rank-num" aria-hidden="true">{index + 1}</span>
          <div>
            <a class="tile-link" href={collectionHref(collection.id)} tabindex="-1" aria-hidden="true">
              <PreviewTile kind="collection" tone={index} catalog={catalog} collection={collection} />
            </a>
            <div class="tile-caption">
              <a href={collectionHref(collection.id)}><span class="visually-hidden">Number {index + 1}: </span>{collection.id}</a>
              <span>{formatCount(collection.stars)} stars</span>
            </div>
          </div>
        </li>
      ))}
    </Rail>

    <Rail id="top-skills" title="Highest-rated skills" viewAll={{ href: "/search/?type=skill&sort=rating", label: "All skills" }}>
      {best.map((skill, index) => (
        <li>
          <a class="tile-link" href={skillHref(skill.id)} tabindex="-1" aria-hidden="true">
            <PreviewTile kind="skill" tone={index + 1} skill={skill} />
          </a>
          <div class="tile-caption">
            <a href={skillHref(skill.id)}>{skill.name}</a>
            <span>{skill.reviewScore.toFixed(1)}/10</span>
          </div>
          <div class="tile-caption"><span style="flex-shrink: 1; overflow-wrap: anywhere">{skill.repo}</span><SecurityLevel level={securityLevel(skill)} short /></div>
        </li>
      ))}
    </Rail>
  </div>
</Base>
