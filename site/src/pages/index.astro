---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import SearchBox from "../components/SearchBox.astro";
import { kitView, loadCatalog } from "../lib/catalog";
import { kitIcon } from "../lib/icons";

const catalog = loadCatalog();
const views = catalog.kits.map((kit) => kitView(catalog, kit.id)).filter((view) => view !== null);
// Ready kits first; the catalog order is kept inside each group.
const kits = [...views.filter((view) => !view.isEmpty), ...views.filter((view) => view.isEmpty)];
const readyCount = views.filter((view) => !view.isEmpty).length;
const plural = (count: number, word: string) => `${count} ${word}${count === 1 ? "" : "s"}`;
const suggestions = ["resume", "pdf", "interview", "scraping", "slides", "testing"];
const stats = [
  { value: String(catalog.skills.length), label: "skills reviewed" },
  { value: String(catalog.collections.length), label: catalog.collections.length === 1 ? "collection" : "collections" },
  { value: `${readyCount} of ${views.length}`, label: "kits ready" },
];
---
<Base title="Skill Kits" description="Hand-checked skill kits for the agent you want to build. Permissive licenses only.">
  <section class="hero" aria-labelledby="hero-title">
    <p class="hero-eyebrow"><Icon name="badge-check" size={16} />Agent skills, reviewed by hand</p>
    <h1 id="hero-title">What are you building?</h1>
    <p class="hero-sub">Pick the agent you want to build and get the skills worth installing. Permissive licenses only.</p>
    <div class="hero-search">
      <SearchBox inputId="home-search" large />
    </div>
    <div class="chips hero-chips">
      <span class="muted small">Try</span>
      {suggestions.map((word) => <a class="chip" href={`/search/?q=${encodeURIComponent(word)}`}>{word}</a>)}
    </div>
  </section>

  <dl class="stats">
    {stats.map((stat) => (
      <div class="stat">
        <dt>{stat.label}</dt>
        <dd>{stat.value}</dd>
      </div>
    ))}
  </dl>

  <section class="section" id="kits" aria-labelledby="kits-title">
    <div class="section-head">
      <h2 id="kits-title">Browse kits</h2>
      <p>One kit per kind of agent. New kits open as their skills pass review.</p>
    </div>
    <ul class="kit-grid">
      {kits.map((view) => (
        <li class:list={["card", "is-clickable", "kit-card", { soon: view.isEmpty }]}>
          <span class:list={["icon-tile", { quiet: view.isEmpty }]}><Icon name={kitIcon(view.kit.id)} size={24} /></span>
          <h3><a class="card-link" href={`/kits/${view.kit.id}/`}>{view.kit.title}</a></h3>
          <p class="kit-desc">{view.kit.description}</p>
          <p class="kit-foot">
            {view.isEmpty ? (
              <span class="badge"><Icon name="clock" size={14} />Coming soon</span>
            ) : (
              <>
                <span class="kit-count">{plural(view.collections.length, "collection")}, {plural(view.skills.length, "skill")}</span>
                <Icon name="arrow-right" size={18} class="kit-arrow" />
              </>
            )}
          </p>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .hero {
    position: relative; display: grid; justify-items: center; gap: var(--space-4);
    padding: var(--space-7) 0 var(--space-6); text-align: center; isolation: isolate;
  }
  .hero::before {
    content: ""; position: absolute; z-index: -1; inset: -2rem -16px auto; height: 22rem;
    background: radial-gradient(ellipse 60% 70% at 50% 0%, var(--glow), transparent 70%);
    pointer-events: none;
  }
  .hero-eyebrow {
    display: inline-flex; align-items: center; gap: var(--space-2); padding: 6px 12px;
    border: 1px solid var(--accent-border); border-radius: 999px; background: var(--accent-soft);
    color: var(--accent-text); font-size: var(--text-sm); font-weight: 500;
  }
  .hero h1 { font-size: clamp(2.25rem, 6vw + 0.5rem, 3.75rem); max-width: 18ch; }
  .hero-sub { color: var(--text-muted); font-size: var(--text-lg); max-width: 52ch; }
  .hero-search { width: 100%; max-width: 40rem; margin-top: var(--space-3); text-align: left; }
  .hero-chips { justify-content: center; max-width: 40rem; }

  .stats {
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin: var(--space-4) auto 0; max-width: 40rem;
    border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--surface);
  }
  .stat { display: flex; flex-direction: column-reverse; gap: 2px; padding: var(--space-4); text-align: center; }
  .stat + .stat { border-left: 1px solid var(--border); }
  .stat dt { color: var(--text-muted); font-size: var(--text-xs); }
  .stat dd { margin: 0; font-size: 1.5rem; font-weight: 700; font-variant-numeric: tabular-nums; letter-spacing: -0.02em; }
  @media (max-width: 479px) {
    .stat { padding: var(--space-3) var(--space-2); }
    .stat dd { font-size: 1.25rem; }
  }

  .kit-grid { list-style: none; display: grid; gap: var(--space-4); grid-template-columns: repeat(auto-fill, minmax(min(100%, 16.5rem), 1fr)); }
  .kit-card { display: flex; flex-direction: column; gap: var(--space-3); }
  .kit-card h3 { font-size: var(--text-lg); }
  .kit-desc { color: var(--text-muted); font-size: var(--text-sm); flex: 1; }
  .kit-foot { display: flex; align-items: center; justify-content: space-between; gap: var(--space-2); min-height: 26px; }
  .kit-count { color: var(--accent-text); font-size: var(--text-sm); font-weight: 600; }
  .kit-card :global(.kit-arrow) { color: var(--accent-text); transition: transform var(--base) var(--ease); }
  .kit-card:hover :global(.kit-arrow) { transform: translateX(3px); }
  .kit-card:not(.soon) { border-color: var(--accent-border); }
  .kit-card.soon h3 a { color: var(--text-muted); }
  .kit-card.soon:hover h3 a { color: var(--text); }
</style>
