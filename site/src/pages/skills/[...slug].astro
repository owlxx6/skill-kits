---
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import CopyCommand from "../../components/CopyCommand.astro";
import Icon from "../../components/Icon.astro";
import LicenseDetails from "../../components/LicenseDetails.astro";
import ReviewStatus from "../../components/ReviewStatus.astro";
import SecurityLevel from "../../components/SecurityLevel.astro";
import { collectionHref, displayDate, kitsOfSkill, loadCatalog, sameNameSkills, securityLevel, skillHref, skillInstallCommand, skillSlug } from "../../lib/catalog";

export function getStaticPaths() {
  return loadCatalog().skills.map((skill) => ({ params: { slug: skillSlug(skill.id) }, props: { skillId: skill.id } }));
}

const catalog = loadCatalog();
const skill = catalog.skills.find((entry) => entry.id === Astro.props.skillId);
if (!skill) throw new Error(`Unknown skill ${Astro.props.skillId}`);
const kits = kitsOfSkill(catalog, skill.id);
const twins = sameNameSkills(catalog, skill);
const isCollection = catalog.collections.some((entry) => entry.id === skill.repo);
const { review } = skill;
const crumbs = [
  { label: "Home", href: "/" },
  ...(kits[0] ? [{ label: kits[0].title, href: `/kits/${kits[0].id}/` }] : [{ label: "Skills", href: "/search/?type=skill" }]),
  { label: skill.name },
];
const scores = [
  { label: "Clarity", value: review.scores.clarity },
  { label: "Completeness", value: review.scores.completeness },
  { label: "Usefulness", value: review.scores.usefulness },
];
const width = (value: number) => `${Math.max(0, Math.min(10, value)) * 10}%`;
---
<Base title={skill.name} description={review.why}>
  <div class="wrap page">
    <header class="page-head">
      <Breadcrumbs items={crumbs} />
      <p class="eyebrow">From <a href={collectionHref(skill.repo)}>{skill.repo}</a></p>
      <h1 class="display" style="font-size: var(--t-title)">{skill.name}</h1>
      <p class="lead">{review.summary}</p>
    </header>

    <div class="split aside-400">
      <div class="primary" style="gap: var(--s8)">
        <section aria-labelledby="install-title" style="display: flex; flex-direction: column; gap: var(--s4)">
          <h2 id="install-title" style="font-size: var(--t-title)">Install</h2>
          <CopyCommand command={skillInstallCommand(skill)} label={`Copy install command for ${skill.name}`} />
          <p class="small muted">Installs this skill only.{isCollection && <> For the whole repository, use <a href={collectionHref(skill.repo)}>the collection</a>.</>} Reviewed, not tested: read it before you run it.</p>
        </section>

        {(review.strengths.length > 0 || review.cautions.length > 0) && (
          <div class="columns-2">
            {review.strengths.length > 0 && (
              <section class="ruled" aria-labelledby="strengths-title">
                <h2 id="strengths-title">What it does well</h2>
                <ul>{review.strengths.map((item) => <li>{item}</li>)}</ul>
              </section>
            )}
            {review.cautions.length > 0 && (
              <section class="ruled warn" aria-labelledby="cautions-title">
                <h2 id="cautions-title">Before you install</h2>
                <ul>{review.cautions.map((item) => <li>{item}</li>)}</ul>
              </section>
            )}
          </div>
        )}

        <section class="scores" aria-labelledby="scores-title">
          <div class="scores-head"><h2 id="scores-title">Review score</h2><p class="mono"><strong>{skill.reviewScore.toFixed(1)}</strong>/10</p></div>
          <dl style="display: flex; flex-direction: column; gap: var(--s3)">
            {scores.map((score) => (
              <div class="score-row">
                <dt>{score.label}</dt>
                <dd><div class="score-bar" aria-hidden="true"><span style={`width: ${width(score.value)}`}></span></div></dd>
                <dd class="score-value">{score.value}<span class="visually-hidden"> out of </span><span aria-hidden="true">/</span>10</dd>
              </div>
            ))}
          </dl>
        </section>
      </div>

      <aside class="side" aria-labelledby="trust-title">
        <h2 id="trust-title" style="font-size: var(--t-md); margin-bottom: var(--s2)">Trust</h2>
        <dl class="facts">
          <dt>License</dt><dd><LicenseDetails skill={skill} /></dd>
          <dt>Security</dt><dd><SecurityLevel level={securityLevel(skill)} /></dd>
          <dt>Review</dt><dd><ReviewStatus /></dd>
          <dt>Last update</dt><dd><time datetime={skill.pushedAt}>{displayDate(skill.pushedAt)}</time></dd>
          <dt>Source</dt><dd><a href={skill.url}>SKILL.md on GitHub <Icon name="external-link" size={14} /></a></dd>
          <dt>Repository</dt><dd><a href={collectionHref(skill.repo)}>{skill.repo}</a></dd>
          {kits.length > 0 && <><dt>In kits</dt><dd>{kits.map((kit, i) => <>{i > 0 && ", "}<a href={`/kits/${kit.id}/`}>{kit.title}</a></>)}</dd></>}
        </dl>
        {twins.length > 0 && (
          <p class="small muted" style="margin-top: var(--s4)">Same name, different source: {twins.map((twin, i) => <>{i > 0 && ", "}<a href={skillHref(twin.id)}>{twin.repo}</a></>)}</p>
        )}
      </aside>
    </div>
  </div>
</Base>
