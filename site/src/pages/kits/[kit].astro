---
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import CollectionRow from "../../components/CollectionRow.astro";
import CopyCommand from "../../components/CopyCommand.astro";
import EmptyState from "../../components/EmptyState.astro";
import SkillRow from "../../components/SkillRow.astro";
import { kitInstallCommand, kitView, loadCatalog, plural } from "../../lib/catalog";

export function getStaticPaths() {
  return loadCatalog().kits.map((kit) => ({ params: { kit: kit.id } }));
}

const catalog = loadCatalog();
const view = kitView(catalog, Astro.params.kit as string);
if (!view) throw new Error(`Unknown kit ${Astro.params.kit}`);
const { kit, collections, skills } = view;
const totalInstalled = collections.reduce((sum, entry) => sum + entry.skillCount, 0);
const totalListed = collections.reduce((sum, entry) => sum + entry.catalogSkillIds.length, 0);
const afterStep = skills.length > 0 ? "03" : "02";
---
<Base title={kit.title} description={kit.description}>
  <div class="wrap page" style="gap: var(--s7)">
    <header class="page-head">
      <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Kits", href: "/#kits" }, { label: kit.title }]} />
      <p class="eyebrow">Kit</p>
      <h1 class="display">{kit.title}</h1>
      <p class="lead">{kit.description}</p>
      <p class="meta-line"><span>Reviewed <time datetime={catalog.generatedAt}>{catalog.generatedAt.slice(0, 10)}</time></span><a href="/methodology/">How we pick</a></p>
    </header>

    {view.isEmpty ? (
      <EmptyState title="This kit is being assembled">
        <p>No skill has passed review for this kit yet. Search covers every reviewed skill in the meantime.</p>
        <div class="button-row"><a class="button primary" href="/search/">Search all skills</a><a class="button" href="/#kits">See other kits</a></div>
      </EmptyState>
    ) : (
      <div class="split">
        {collections.length > 0 && (
          <aside class="side install-box" aria-labelledby="quick-title">
            <h2 id="quick-title">Install this kit</h2>
            <p>{plural(collections.length, "command")}, run in this order. {collections.length > 1 ? "This line runs them one after another." : ""}</p>
            <CopyCommand command={kitInstallCommand(collections.map((entry) => entry.id))} label={`Copy the install command for the whole ${kit.title} kit`} />
            <p>Installs {totalInstalled.toLocaleString("en-US")} skills in total, {totalListed.toLocaleString("en-US")} of them listed here after review.</p>
          </aside>
        )}
        <div class="primary">
          {collections.length > 0 && (
            <section aria-labelledby="parts-title">
              <div class="section-head">
                <h2 id="parts-title"><span class="step-no">01</span>Install the collections, in this order</h2>
                <p>Parts list · {collections.length}</p>
              </div>
              <ol class="parts">{collections.map((collection, index) => <CollectionRow catalog={catalog} collection={collection} index={index} />)}</ol>
            </section>
          )}
          {skills.length > 0 && (
            <section aria-labelledby="single-title">
              <div class="section-head">
                <h2 id="single-title"><span class="step-no">{collections.length > 0 ? "02" : "01"}</span>Add single skills</h2>
                <p>{collections.length > 0 ? "Optional · " : ""}{plural(skills.length, "skill")} picked for this job</p>
              </div>
              <ul class="rows">{skills.map((skill) => <SkillRow skill={skill} />)}</ul>
            </section>
          )}
          <section aria-labelledby="after-title">
            <div class="section-head"><h2 id="after-title"><span class="step-no">{collections.length > 0 ? afterStep : "02"}</span>After installing</h2></div>
            <ol class="steps-after">
              <li>Start a new agent session so it loads the new skills.</li>
              <li>Open each part and read its cautions before the first run. Skills are reviewed, not tested.</li>
              <li>Ask for the job in plain words. Your agent picks the matching skill.</li>
            </ol>
          </section>
        </div>
      </div>
    )}
  </div>
</Base>
