---
import Base from "../layouts/Base.astro";
import EmptyState from "../components/EmptyState.astro";
import Icon from "../components/Icon.astro";
import SearchBox from "../components/SearchBox.astro";

const suggestions = ["resume", "pdf", "interview", "scraping", "slides", "testing"];
const filters = [
  { value: "all", label: "All" },
  { value: "skill", label: "Skills" },
  { value: "collection", label: "Collections" },
];
---
<Base title="Search" description="Search the reviewed skills and collections.">
  <div class="narrow">
    <header class="search-head">
      <h1>Search</h1>
      <p class="muted">Skills and collections, by task, tool or file type.</p>
    </header>

    <SearchBox inputId="search-input" formId="search-form" large submitButton={false} placeholder="resume, pdf, scraping..." />

    <div class="toolbar" hidden>
      <div class="chips" role="group" aria-label="Result type" id="type-filters">
        {filters.map((filter) => (
          <button type="button" class="chip" data-type={filter.value} aria-pressed={filter.value === "all" ? "true" : "false"}>
            {filter.label} <span class="count" data-count={filter.value}></span>
          </button>
        ))}
      </div>
      <p class="muted small" id="search-status" role="status" aria-live="polite"></p>
    </div>

    <ul class="card-list" id="search-results"></ul>

    <div id="state-start">
      <EmptyState icon="search" title="Find a skill for your agent">
        <p>Type a task, a tool or a file type. Results update as you type.</p>
        <div class="chips">
          {suggestions.map((word) => <a class="chip" href={`/search/?q=${encodeURIComponent(word)}`}>{word}</a>)}
        </div>
      </EmptyState>
    </div>
    <div id="state-empty" hidden>
      <EmptyState icon="search-x" title="No results">
        <p id="state-empty-text">Nothing matches that search. Try a broader word, or one of these:</p>
        <div class="chips">
          {suggestions.map((word) => <a class="chip" href={`/search/?q=${encodeURIComponent(word)}`}>{word}</a>)}
        </div>
      </EmptyState>
    </div>
    <div id="state-error" hidden>
      <EmptyState icon="triangle-alert" title="Search is unavailable right now">
        <p>The search index did not load. Reload the page, or browse the kits instead.</p>
        <div class="button-row"><a class="button primary" href="/#kits">Browse kits</a></div>
      </EmptyState>
    </div>
  </div>

  <template id="icon-skill"><Icon name="puzzle" size={14} /></template>
  <template id="icon-collection"><Icon name="layers" size={14} /></template>
  <template id="icon-license"><Icon name="scale" size={14} /></template>
  <template id="icon-arrow"><Icon name="arrow-right" size={18} class="result-arrow" /></template>
</Base>

<script>
  import MiniSearch from "minisearch";
  import { SEARCH_OPTIONS, type SearchDocument } from "../lib/search";

  type Kind = SearchDocument["kind"];
  type TypeFilter = Kind | "all";

  const input = document.getElementById("search-input") as HTMLInputElement;
  const form = document.getElementById("search-form") as HTMLFormElement;
  const status = document.getElementById("search-status") as HTMLParagraphElement;
  const results = document.getElementById("search-results") as HTMLUListElement;
  const filterButtons = [...document.querySelectorAll<HTMLButtonElement>("#type-filters button[data-type]")];
  const states = {
    start: document.getElementById("state-start") as HTMLElement,
    empty: document.getElementById("state-empty") as HTMLElement,
    error: document.getElementById("state-error") as HTMLElement,
  };
  const emptyText = document.getElementById("state-empty-text") as HTMLParagraphElement;
  const toolbar = document.querySelector<HTMLElement>(".toolbar");

  const isTypeFilter = (value: string | null | undefined): value is TypeFilter =>
    value === "all" || value === "skill" || value === "collection";

  // Icons are rendered once by the server into <template> elements and cloned here.
  const icon = (id: string): Node => {
    const template = document.getElementById(id) as HTMLTemplateElement | null;
    return template?.content.firstElementChild?.cloneNode(true) ?? document.createTextNode("");
  };

  const element = <K extends keyof HTMLElementTagNameMap>(tag: K, className: string, text?: string) => {
    const node = document.createElement(tag);
    node.className = className;
    if (text !== undefined) node.textContent = text;
    return node;
  };

  const indexPromise = fetch("/search-index.json")
    .then((response) => {
      if (!response.ok) throw new Error(`search index returned ${response.status}`);
      return response.text();
    })
    .then((json) => MiniSearch.loadJSON<SearchDocument>(json, SEARCH_OPTIONS));

  const params = new URL(window.location.href).searchParams;
  const initialType = params.get("type");
  let typeFilter: TypeFilter = isTypeFilter(initialType) ? initialType : "all";
  input.value = params.get("q") ?? "";

  const showState = (name: keyof typeof states | null) => {
    for (const [key, node] of Object.entries(states)) node.hidden = key !== name;
  };

  const renderHit = (hit: { kind: Kind; title: string; href: string; license: string; why: string }) => {
    const item = element("li", "card is-clickable result");
    const head = element("div", "result-head");
    const type = element("span", hit.kind === "skill" ? "badge accent" : "badge");
    type.append(icon(hit.kind === "skill" ? "icon-skill" : "icon-collection"), hit.kind === "skill" ? "Skill" : "Collection");
    const license = element("span", "badge");
    license.append(icon("icon-license"), hit.license);
    head.append(type, license);
    const title = element("h2", "result-title");
    const link = element("a", "card-link", hit.title);
    link.href = hit.href;
    title.append(link);
    const body = element("div", "result-body");
    body.append(title);
    if (hit.why) body.append(element("p", "result-why", hit.why));
    item.append(head, body, icon("icon-arrow"));
    return item;
  };

  const render = async () => {
    const query = input.value.trim();
    const url = new URL(window.location.href);
    if (query) url.searchParams.set("q", query);
    else url.searchParams.delete("q");
    if (typeFilter === "all") url.searchParams.delete("type");
    else url.searchParams.set("type", typeFilter);
    window.history.replaceState(null, "", url);

    for (const button of filterButtons) button.setAttribute("aria-pressed", String(button.dataset.type === typeFilter));
    results.replaceChildren();

    if (!query) {
      status.textContent = "";
      if (toolbar) toolbar.hidden = true;
      for (const count of document.querySelectorAll<HTMLElement>("[data-count]")) count.textContent = "";
      showState("start");
      return;
    }

    let index: MiniSearch<SearchDocument>;
    try {
      index = await indexPromise;
    } catch {
      status.textContent = "";
      if (toolbar) toolbar.hidden = true;
      showState("error");
      return;
    }
    // A newer keystroke has already rendered; drop this stale pass.
    if (input.value.trim() !== query) return;

    const hits = index.search(query).slice(0, 50).map((hit) => ({
      kind: hit.kind as Kind,
      title: String(hit.title),
      href: String(hit.href),
      license: String(hit.license),
      why: String(hit.why ?? ""),
    }));
    const counts = { all: hits.length, skill: 0, collection: 0 };
    for (const hit of hits) counts[hit.kind] += 1;
    for (const count of document.querySelectorAll<HTMLElement>("[data-count]")) {
      const key = count.dataset.count;
      count.textContent = isTypeFilter(key) ? String(counts[key]) : "";
    }

    const shown = typeFilter === "all" ? hits : hits.filter((hit) => hit.kind === typeFilter);
    if (toolbar) toolbar.hidden = hits.length === 0;
    if (shown.length === 0) {
      status.textContent = "";
      emptyText.textContent =
        hits.length === 0
          ? `Nothing matches "${query}". Try a broader word, or one of these:`
          : `No ${typeFilter === "skill" ? "skill" : "collection"} matches "${query}". Show all results, or try one of these:`;
      showState("empty");
      return;
    }
    showState(null);
    status.textContent = `${shown.length} result${shown.length === 1 ? "" : "s"} for "${query}"`;
    results.append(...shown.map(renderHit));
  };

  for (const button of filterButtons) {
    button.addEventListener("click", () => {
      const value = button.dataset.type;
      if (!isTypeFilter(value)) return;
      typeFilter = value;
      render();
    });
  }
  input.addEventListener("input", render);
  form.addEventListener("submit", (event) => {
    event.preventDefault();
    render();
  });
  render();
</script>

<style>
  .search-head { display: grid; gap: var(--space-2); margin-bottom: var(--space-5); }
  .toolbar {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between;
    gap: var(--space-3) var(--space-4); margin: var(--space-4) 0;
  }
  #search-results:not(:empty) { margin-bottom: var(--space-4); }
  #state-start, #state-empty, #state-error { margin-top: var(--space-5); }

  #search-results :global(.result) {
    display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: var(--space-2) var(--space-4); align-items: center;
  }
  #search-results :global(.result-head) { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: var(--space-2); }
  #search-results :global(.result-body) { display: grid; gap: var(--space-1); min-width: 0; }
  #search-results :global(.result-title) { font-size: var(--text-lg); overflow-wrap: anywhere; }
  #search-results :global(.result-why) { color: var(--text-muted); font-size: var(--text-sm); }
  #search-results :global(.result-arrow) { color: var(--text-muted); transition: color var(--base) var(--ease), transform var(--base) var(--ease); }
  #search-results :global(.result:hover .result-arrow) { color: var(--accent-text); transform: translateX(3px); }
</style>
