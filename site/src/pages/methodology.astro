---
import Base from "../layouts/Base.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { loadConfig } from "../lib/methodology";

const config = await loadConfig();
const { filter, review, scoring } = config;
const percent = (value: number) => `${Math.round(value * 100)}%`;
const steps: { title: string; text: string }[] = [
  {
    title: "Found and filtered",
    text: "We read public GitHub repositories tagged with agent-skill topics, plus explicit nominations. Archived repositories are held back. Last-update dates are shown as context: an older skill can remain useful and is not rejected for age alone. Topic searches currently use a " + filter.minStars + "-star discovery threshold. Explicitly nominated repositories have no minimum star count: low usage does not disqualify them.",
  },
  {
    title: "Complete collection inventory",
    text: "Selected collections list their available skills, including members without an editorial review. Source listings use the repository's description and carry no editorial score. Unresolved entries stay pending while their files and admission checks are processed.",
  },
  {
    title: "License shown per skill",
    text: 'Each skill’s license is resolved from its files and metadata, applicable parent folders and repository evidence. A repository can contain several licenses. Missing licenses are shown as "No license", and unresolved evidence as "Unclear license". Mixed collections list the included licenses. Check the source terms for your intended use.',
  },
  {
    title: "Ranked",
    text: `Editorial reviews score clarity, completeness and usefulness. Recommendations require at least ${review.minCatalogScore}/10; that threshold does not hide other available collection members. A collection needs at least ${config.collection.minSkills} distinct skills. Popularity is discovery metadata, not a quality guarantee.`,
  },
  {
    title: "Approved by a human",
    text: 'The best candidates are proposed to the curator, who approves or rejects each one and sets the order you see on a kit page.',
  },
];
---
<Base title="How we pick" description="How skills are found, filtered, reviewed and approved.">
  <div class="wrap page" style="gap: var(--s7)">
    <header class="page-head">
      <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "How we pick" }]} />
      <p class="eyebrow">Trust</p>
      <h1 class="display">How we pick</h1>
      <p class="lead">Explore how selected collections become a browsable directory, with editorial recommendations kept separate from source listings.</p>
    </header>

    <ol class="method-steps">
      {steps.map((step, index) => (
        <li>
          <span class="part-no" aria-hidden="true">{index + 1}</span>
          <div>
            <h2><span class="visually-hidden">Step {index + 1}: </span>{step.title}</h2>
            <p>{step.text}</p>
          </div>
        </li>
      ))}
    </ol>

    <aside class="callout" aria-labelledby="limits-title">
      <h2 id="limits-title">Before installing</h2>
      <p>The catalog records reviews of skill instructions. A review score does not demonstrate successful execution of every task. Read the source, prerequisites and license before installing.</p>
    </aside>
  </div>
</Base>
