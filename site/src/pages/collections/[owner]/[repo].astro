---
import Base from "../../../layouts/Base.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import CopyCommand from "../../../components/CopyCommand.astro";
import EmptyState from "../../../components/EmptyState.astro";
import Icon from "../../../components/Icon.astro";
import ReviewStatus from "../../../components/ReviewStatus.astro";
import ScopeNote from "../../../components/ScopeNote.astro";
import SecurityLevel from "../../../components/SecurityLevel.astro";
import SkillRow from "../../../components/SkillRow.astro";
import {
  collectionInstallCommand,
  collectionLicenseLabel,
  collectionSlug,
  displayDate,
  kitsOfCollection,
  kitsOfSkill,
  licenseOptions,
  listedSecurityLevel,
  loadCatalog,
  plural,
} from "../../../lib/catalog";

export function getStaticPaths() {
  const catalog = loadCatalog();
  // Every repository that has a catalog skill gets a page, collection or not, so skill pages can link to it.
  const repos = [...new Set(catalog.skills.map((skill) => skill.repo))];
  return repos.map((id) => ({ params: collectionSlug(id), props: { repoId: id } }));
}

const catalog = loadCatalog();
const repoId = Astro.props.repoId as string;
const collection = catalog.collections.find((entry) => entry.id === repoId) ?? null;
const skills = catalog.skills.filter((skill) => skill.repo === repoId);
const kits = kitsOfCollection(catalog, repoId);
const skillKits = [...new Map(skills.flatMap((skill) => kitsOfSkill(catalog, skill.id)).map((kit) => [kit.id, kit])).values()];
const crumbKit = kits[0] ?? skillKits[0];
const listedLicenses = licenseOptions(skills);
const updated = collection?.pushedAt ?? skills.map((skill) => skill.pushedAt).sort().at(-1) ?? "";
const listed = collection ? collection.catalogSkillIds.length : skills.length;
const filterable = skills.length > 8;
---
<Base title={repoId} description={collection?.description ?? `Skills from ${repoId}`}>
  <div class="wrap page" style="gap: var(--s7)">
    <header class="page-head">
      <Breadcrumbs items={[{ label: "Home", href: "/" }, ...(crumbKit ? [{ label: crumbKit.title, href: `/kits/${crumbKit.id}/` }] : []), { label: repoId }]} />
      <p class="eyebrow">{collection ? "Collection · whole repository" : "Repository"}</p>
      <h1 class="display" style="font-size: clamp(2rem, 1.2rem + 3vw, 3.25rem)">{repoId}</h1>
    </header>

    <div class="split even">
      <section class="primary install-box" style="gap: var(--s4)" aria-labelledby="install-title">
        <h2 id="install-title" class="visually-hidden">Install {collection ? "the collection" : "the repository"}</h2>
        {collection ? (
          <>
            <p style="font-size: clamp(2.25rem, 1.6rem + 2.4vw, 3rem); line-height: 1; font-weight: 700; letter-spacing: -0.02em; color: var(--text)">
              {listed.toLocaleString("en-US")} <span class="muted" style="font-weight: 600">of</span> {collection.skillCount.toLocaleString("en-US")}
            </p>
            <p style="font-size: var(--t-md); font-weight: 600; color: var(--text)">skills in this repository are listed here.</p>
            <ScopeNote collection={collection} />
          </>
        ) : (
          <>
            <p style="font-size: var(--t-md); font-weight: 600; color: var(--text)" data-collection-coverage>{plural(skills.length, "skill")} from this repository listed here after review.</p>
            <div class="scope partial"><Icon name="triangle-alert" size={16} /><p data-install-scope>Installs every skill in this repository, not only the skills listed here.</p></div>
          </>
        )}
        <CopyCommand command={collectionInstallCommand(repoId)} label={`Copy install command for ${repoId}`} />
      </section>

      <section class="side" aria-labelledby="trust-title">
        <h2 id="trust-title" style="font-size: var(--t-md); margin-bottom: var(--s2)">Trust</h2>
        <dl class="facts">
          <dt>License</dt><dd>{collection ? collectionLicenseLabel(collection) : `Listed skills: ${listedLicenses.join(", ")}`}</dd>
          <dt>Security</dt><dd><SecurityLevel level={listedSecurityLevel(catalog, repoId)} /><span class="hint">Highest level among the {plural(listed, "listed skill")}. Unlisted skills are not shown here.</span></dd>
          <dt>Review</dt><dd><ReviewStatus /></dd>
          {updated && <><dt>Last update</dt><dd><time datetime={updated}>{displayDate(updated)}</time></dd></>}
          <dt>Source</dt><dd><a href={`https://github.com/${repoId}`}>github.com/{repoId} <Icon name="external-link" size={14} /></a></dd>
          {kits.length > 0 && <><dt>In kits</dt><dd>{kits.map((kit, i) => <>{i > 0 && ", "}<a href={`/kits/${kit.id}/`}>{kit.title}</a></>)}</dd></>}
        </dl>
        {collection?.description && <blockquote class="quote" style="margin-top: var(--s4)"><cite>From the repository, not reviewed text</cite>{collection.description}</blockquote>}
      </section>
    </div>

    <section aria-labelledby="skills-title">
      <div class="section-head">
        <h2 id="skills-title">Listed skills</h2>
        <p id="skill-count" aria-live="polite">{plural(skills.length, "skill")} · each can also be installed alone</p>
      </div>
      {filterable && (
        <div class="button-row" role="group" aria-label="Filter listed skills" style="padding: var(--s4) 0; border-bottom: 1px solid var(--rule)">
          <label class="field" for="license-filter">License
            <select id="license-filter"><option value="">All</option>{listedLicenses.map((license) => <option value={license}>{license}</option>)}</select>
          </label>
          <label class="field" for="security-filter">Security
            <select id="security-filter"><option value="">All</option><option value="none">No flags</option><option value="notice">Notice</option><option value="severe">Severe</option></select>
          </label>
          <label class="field" for="skill-sort">Order
            <select id="skill-sort"><option value="name">Name</option><option value="review">Review score</option><option value="updated">Recently updated</option></select>
          </label>
        </div>
      )}
      <ul class="rows" id="skill-list">{[...skills].sort((a, b) => a.name.localeCompare(b.name, "en")).map((skill) => <SkillRow skill={skill} showRepo={false} />)}</ul>
      <div id="no-match" hidden>
        <EmptyState title="No listed skill matches these filters" headingLevel={3}><p>Choose another license or security level.</p></EmptyState>
      </div>
    </section>
  </div>
</Base>

<script>
  const list = document.getElementById("skill-list");
  const license = document.getElementById("license-filter") as HTMLSelectElement | null;
  const security = document.getElementById("security-filter") as HTMLSelectElement | null;
  const sort = document.getElementById("skill-sort") as HTMLSelectElement | null;
  const count = document.getElementById("skill-count");
  const noMatch = document.getElementById("no-match");
  if (list && license && security && sort && count && noMatch) {
    const rows = [...list.querySelectorAll<HTMLLIElement>(":scope > li")];
    const total = rows.length;
    const apply = () => {
      const ordered = [...rows].sort((a, b) =>
        sort.value === "review" ? Number(b.dataset.review) - Number(a.dataset.review)
        : sort.value === "updated" ? String(b.dataset.updated).localeCompare(String(a.dataset.updated))
        : String(a.dataset.name).localeCompare(String(b.dataset.name), "en"));
      let visible = 0;
      for (const row of ordered) {
        const show = (!license.value || row.dataset.license === license.value) && (!security.value || row.dataset.security === security.value);
        row.hidden = !show;
        if (show) visible += 1;
        list.append(row);
      }
      noMatch.hidden = visible > 0;
      count.textContent = visible === total ? `${total} skills · each can also be installed alone` : `${visible} of ${total} skills`;
    };
    for (const select of [license, security, sort]) select.addEventListener("change", apply);
  }
</script>
