---
import Base from "../../../layouts/Base.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import CopyCommand from "../../../components/CopyCommand.astro";
import Icon from "../../../components/Icon.astro";
import SkillRow from "../../../components/SkillRow.astro";
import { collectionInstallCommand, collectionSlug, formatCount, kitsOfCollection, kitsOfSkill, loadCatalog } from "../../../lib/catalog";
import { kitIcon } from "../../../lib/icons";

export function getStaticPaths() {
  const catalog = loadCatalog();
  // Every repository that has a catalog skill gets a page, collection or not, so skill pages can link to it.
  const repos = [...new Set(catalog.skills.map((skill) => skill.repo))];
  return repos.map((id) => ({ params: collectionSlug(id), props: { repoId: id } }));
}

const catalog = loadCatalog();
const repoId = Astro.props.repoId as string;
const collection = catalog.collections.find((entry) => entry.id === repoId) ?? null;
const skills = catalog.skills.filter((skill) => skill.repo === repoId);
const kits = kitsOfCollection(catalog, repoId);
const sample = skills[0];
// The breadcrumb goes through a kit when the collection, or else one of its skills, belongs to one.
const crumbKit = kits[0] ?? skills.flatMap((skill) => kitsOfSkill(catalog, skill.id))[0];
const crumbs = [
  { label: "Home", href: "/" },
  ...(crumbKit ? [{ label: crumbKit.title, href: `/kits/${crumbKit.id}/` }] : []),
  { label: repoId },
];
---
<Base title={repoId} description={collection?.description ?? `Skills from ${repoId}`}>
  <div class="narrow">
    <Breadcrumbs items={crumbs} />
    <header class="page-head">
      <span class="icon-tile large"><Icon name="layers" size={28} /></span>
      <div class="page-head-text">
        <h1>{repoId}</h1>
        {sample && (
          <p class="meta">
            <span><Icon name="scale" size={14} />{sample.license}</span>
            <span><Icon name="star" size={14} />{formatCount(sample.stars)} stars</span>
            <span><Icon name="git-fork" size={14} />{formatCount(sample.forks)} forks</span>
            <a href={`https://github.com/${repoId}`}><Icon name="external-link" size={14} />Repository on GitHub</a>
          </p>
        )}
        {collection?.humanReviewed && (
          <div class="badges"><span class="badge accent"><Icon name="badge-check" size={14} />Reviewed by a human</span></div>
        )}
      </div>
    </header>

    {collection?.description && <p class="lead summary">{collection.description}</p>}

    <section class="card install" aria-labelledby="install-title">
      <h2 id="install-title"><Icon name="terminal" size={18} />Install {collection ? "the collection" : "the repository"}</h2>
      <CopyCommand command={collectionInstallCommand(repoId)} />
      <p class="muted small">
        {collection
          ? `${collection.skillCount} skills in this repository; ${skills.length} listed here after review.`
          : `${skills.length} skill${skills.length === 1 ? "" : "s"} from this repository listed here after review.`}
      </p>
    </section>

    {kits.length > 0 && (
      <section class="block" aria-labelledby="kits-title">
        <h2 id="kits-title" class="block-title">In these kits</h2>
        <div class="chips">
          {kits.map((kit) => <a class="chip" href={`/kits/${kit.id}/`}><Icon name={kitIcon(kit.id)} size={16} />{kit.title}</a>)}
        </div>
      </section>
    )}

    <section class="section" aria-labelledby="skills-title">
      <div class="section-head">
        <h2 id="skills-title">Reviewed skills</h2>
        <p>{skills.length} skill{skills.length === 1 ? "" : "s"}</p>
      </div>
      <ul class="card-list">{skills.map((skill) => <SkillRow skill={skill} showRepo={false} />)}</ul>
    </section>
  </div>
</Base>

<style>
  .summary { margin-top: var(--space-5); color: var(--text); }
  .install, .block { margin-top: var(--space-5); }
  .install { display: grid; gap: var(--space-3); }
  .install h2 { display: flex; align-items: center; gap: var(--space-2); font-size: var(--text-base); }
  .block-title { margin-bottom: var(--space-3); }
</style>
